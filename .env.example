# Shopify Storefront API (Settings → Apps → Develop apps → Storefront API).
# Leave empty to use the demo catalogue in src/catalog.js.
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_TOKEN=

# Bandsintown (Bandsintown for Artists → Settings → General → Get API key).
# Artist defaults to "Obsimo"; set a name or "id_<artist id>" to override. Without a key no dates are shown.
VITE_BANDSINTOWN_ARTIST=
VITE_BANDSINTOWN_APP_ID=

# Dashboard /ventes (serveur uniquement, jamais de préfixe VITE_ : voir le README).
DASHBOARD_PASSWORD=
SUPABASE_URL=https://gzmbrpzeajjmoluceryb.supabase.co
SUPABASE_SECRET_KEY=
SHOPIFY_WEBHOOK_SECRET=
SUMUP_API_KEY=
CRON_SECRET=
# Facultatif : historique des commandes et envoi du stock vers Shopify
SHOPIFY_ADMIN_TOKEN=
